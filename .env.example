# =============================================================================
# Frontend — everything here is bundled into the browser and is PUBLIC.
# Never put a secret behind a VITE_ prefix.
# =============================================================================

# --- Firebase (web config is public by design; access is controlled by
#     firestore.rules, not by keeping these quiet) --------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# --- The Worker that holds the privileged operations ----------------------
# e.g. https://guestbook-api.<your-subdomain>.workers.dev
VITE_API_BASE_URL=""

# --- Internal auth identities ---------------------------------------------
# Usernames are mapped to <username>@<this domain> inside Firebase Auth.
# It is never shown in the UI and never receives mail. Must match
# AUTH_EMAIL_DOMAIN in workers/api/wrangler.toml.
VITE_AUTH_EMAIL_DOMAIN="users.guestbook.local"

# --- EmailJS (browser-side by design; the public key is meant to ship) ----
VITE_EMAILJS_PUBLIC_KEY=""
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ORDER_READY=""
VITE_EMAILJS_TEMPLATE_ORDER_SHIPPED=""
VITE_EMAILJS_TEMPLATE_GUESTBOOK_READY=""
VITE_EMAILJS_TEMPLATE_ALBUM_READY=""
VITE_EMAILJS_TEMPLATE_CREDENTIALS=""
VITE_EMAILJS_TEMPLATE_PAYMENT_REMINDER=""
VITE_EMAILJS_TEMPLATE_CUSTOM=""

# --- Cloudflare Turnstile (site key is public) ----------------------------
VITE_TURNSTILE_SITE_KEY=""

# --- Where the app is served from, for QR codes and share links -----------
VITE_APP_URL="https://imed458.github.io/Guestbook/"

# =============================================================================
# Worker secrets — these live ONLY in `wrangler secret put`, never in a file
# that Git can see and never with a VITE_ prefix:
#
#   FIREBASE_SERVICE_ACCOUNT   the full service-account JSON
#   R2_ACCOUNT_ID
#   R2_ACCESS_KEY_ID
#   R2_SECRET_ACCESS_KEY
#   TURNSTILE_SECRET_KEY
#
# See workers/api/wrangler.toml and the README.
# =============================================================================
