# ---------------------------------------------------------------
# Firebase (web config is public by design — protected by Firestore
# security rules, not by secrecy). Optional: sane defaults are baked
# into src/lib/firebase.ts, so the app runs without a .env file.
# ---------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# ---------------------------------------------------------------
# Cloudinary — photos and videos.
# ONLY the cloud name and the *unsigned* upload preset belong here.
# Never put CLOUDINARY_API_SECRET in a frontend build.
# ---------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""
