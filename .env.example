# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL="file:./data/guestbook.db"

# Authentication secret for signing session tokens
AUTH_SECRET="your-super-secret-jwt-key-min-32-chars"

# App Public URL for QR codes and sharing links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Cloudinary / Storage for media uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

