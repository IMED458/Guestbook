# =============================================================================
# Production configuration, committed on purpose.
#
# Everything here is public by design and is already visible to anyone who
# opens the built bundle:
#
#   • A Firebase web config identifies the project; it authorises nothing.
#     Access is controlled by firestore.rules.
#   • An EmailJS public key is meant to ship in the browser. What protects it
#     is the allowed-origins list in the EmailJS dashboard.
#   • The Worker URL is a public endpoint that verifies a Firebase ID token on
#     every privileged call.
#
# Real secrets — the Firebase service account, the R2 keys, the Turnstile
# secret — live only in `wrangler secret put` and never reach this repository.
# =============================================================================

VITE_API_BASE_URL="https://guestbook-api.guestbook-api.workers.dev"
VITE_AUTH_EMAIL_DOMAIN="users.guestbook.local"
VITE_APP_URL="https://imed458.github.io/Guestbook/"

VITE_EMAILJS_PUBLIC_KEY="VqRUxp5-WWl51OifI"
VITE_EMAILJS_SERVICE_ID="service_kz2r208"
VITE_EMAILJS_TEMPLATE_DEFAULT="template_dtne3k8"

# The demo account must never exist on a real deployment.
VITE_ENABLE_DEMO="false"
